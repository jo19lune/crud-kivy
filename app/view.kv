#:import MDBoxLayout kivymd.uix.boxlayout.MDBoxLayout
#:import MDCard kivymd.uix.card.MDCard
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDTextField kivymd.uix.textfield.MDTextField
#:import MDIconButton kivymd.uix.button.MDIconButton
#:import MDSwitch kivymd.uix.selectioncontrol.MDSwitch
#:import MDCheckbox kivymd.uix.selectioncontrol.MDCheckbox
#:import OneLineListItem kivymd.uix.list.OneLineListItem
#:import TwoLineListItem kivymd.uix.list.TwoLineListItem
#:import ThreeLineListItem kivymd.uix.list.ThreeLineListItem
#:import MDList kivymd.uix.list.MDList
#:import MDScreen kivymd.uix.screen.MDScreen
#:import MDRectangleFlatButton kivymd.uix.button.MDRectangleFlatButton
#:import Factory kivy.factory.Factory

<ImageDialog@MDBoxLayout>:
    orientation: 'vertical'
    spacing: dp(15)
    padding: dp(20)
    size_hint_y: None
    height: dp(150)

    MDLabel:
        text: "Choisir une image"
        halign: "center"
        font_style: "H6"

    MDBoxLayout:
        orientation: 'horizontal'
        spacing: dp(10)
        size_hint_y: None
        height: dp(50)

        MDRectangleFlatButton:
            text: "Prendre une photo"
            on_release: app.open_camera()
            size_hint_x: 0.5

        MDRectangleFlatButton:
            text: "Choisir depuis galerie"
            on_release: app.open_gallery()
            size_hint_x: 0.5

<MainScreen>:
    selected_image_path: "assets/logo.png"
    
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(10)

        # Barre de recherche
        MDTextField:
            id: search_input
            hint_text: "Rechercher..."
            icon_left: "magnify"
            on_text: app.controller.refresh_view(self.text)
            size_hint_x: 1

        # Barre d'outils
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(10)

            MDTextField:
                id: name_input
                hint_text: "Nom de l'item"
                size_hint_x: 0.25

            MDTextField:
                id: desc_input
                hint_text: "Description"
                size_hint_x: 0.25

            MDRectangleFlatButton:
                id: image_btn
                text: "Choisir image"
                size_hint_x: 0.2
                on_release: app.show_image_dialog()

            MDRaisedButton:
                text: "Ajouter"
                size_hint_x: 0.15
                on_release: 
                    app.controller.add_item(name_input.text, desc_input.text, root.selected_image_path)
                    name_input.text = ""
                    desc_input.text = ""
                    root.selected_image_path = "assets/logo.png"
                    image_btn.text = "Choisir image"

            MDRaisedButton:
                id: delete_selected_btn
                text: "Supprimer sélection"
                size_hint_x: 0.15
                disabled: True
                on_release: app.controller.delete_selected_items()

        # Barre d'actions
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(10)

            MDRaisedButton:
                text: "Tout sélectionner"
                size_hint_x: 0.3
                on_release: app.controller.select_all_items()

            MDRaisedButton:
                text: "Effacer sélection"
                size_hint_x: 0.3
                on_release: app.controller.clear_selection()

            MDBoxLayout:
                size_hint_x: 0.4
                spacing: dp(5)

                MDLabel:
                    text: "Mode Grille"
                    halign: "right"
                    valign: "center"
                    size_hint_x: 0.6

                MDSwitch:
                    id: view_mode_switch
                    size_hint_x: 0.4
                    on_active: app.controller.toggle_view_mode()

        MDLabel:
            text: "Mes Items"
            halign: "center"
            font_style: "H5"
            adaptive_height: True
            theme_text_color: "Primary"

        ScrollView:
            BoxLayout:
                id: main_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                # Conteneur pour la vue grille
                GridLayout:
                    id: grid_container
                    cols: 2
                    spacing: dp(15)
                    padding: dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                # Conteneur pour la vue liste
                MDList:
                    id: list_container
                    size_hint_y: None
                    height: self.minimum_height

<ItemCard@MDCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: "240dp"
    padding: "10dp"
    spacing: "10dp"
    elevation: 2
    md_bg_color: app.controller.get_card_color(root.item_id) if hasattr(root, 'item_id') else [1, 1, 1, 1]
    
    MDBoxLayout:
        adaptive_height: True
        spacing: dp(5)
        
        MDCheckbox:
            id: item_checkbox
            size_hint: None, None
            size: dp(24), dp(24)
            on_active: app.controller.toggle_item_selection(root.item_id)
        
        MDIconButton:
            icon: "pencil"
            size_hint: None, None
            size: dp(24), dp(24)
            theme_text_color: "Secondary"
            on_release: app.controller.edit_item(root.item_id)
    
    AsyncImage:
        source: root.source
        size_hint_y: 0.6
        allow_stretch: True
        keep_ratio: True
    
    MDLabel:
        text: root.name
        halign: "center"
        font_style: "Subtitle1"
        bold: True
        size_hint_y: 0.2
        text_size: self.width, None
    
    MDLabel:
        text: root.desc
        halign: "center" 
        font_style: "Body2"
        theme_text_color: "Secondary"
        size_hint_y: 0.2
        text_size: self.width, None

<ListItem@MDBoxLayout>:
    orientation: 'horizontal'
    adaptive_height: True
    spacing: dp(10)
    padding: dp(10)
    size_hint_y: None
    height: dp(80)
    item_id: ""
    
    MDCheckbox:
        id: list_checkbox
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {'center_y': 0.5}
        on_active: app.controller.toggle_item_selection(root.item_id)
    
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(5)
        adaptive_height: True
        size_hint_x: 0.7  # Réserver de l'espace pour le bouton
        pos_hint: {'center_y': 0.5}
        
        MDLabel:
            text: root.text
            font_style: "Subtitle1"
            theme_text_color: "Primary"
            adaptive_height: True
        
        MDLabel:
            text: root.secondary_text
            font_style: "Body2"
            theme_text_color: "Secondary"
            adaptive_height: True
    
    # BOUTON D'ÉDITION AJOUTÉ ICI
    MDIconButton:
        icon: "pencil"
        size_hint: None, None
        size: dp(40), dp(40)
        theme_text_color: "Secondary"
        pos_hint: {'center_y': 0.5}
        on_release: app.controller.edit_item(root.item_id)

<EditDialogContent>:
    orientation: 'vertical'
    spacing: dp(15)
    padding: dp(20)
    size_hint_y: None
    height: dp(250)

    MDLabel:
        text: "Modifier l'item"
        halign: "center"
        font_style: "H6"
        size_hint_y: None
        height: dp(40)

    MDTextField:
        id: name_input
        hint_text: "Nom de l'item"
        size_hint_y: None
        height: dp(60)

    MDTextField:
        id: desc_input
        hint_text: "Description"
        size_hint_y: None
        height: dp(60)

    MDRectangleFlatButton:
        text: "Changer l'image"
        size_hint_y: None
        height: dp(50)
        on_release: app.show_image_dialog()
