#:import MDBoxLayout kivymd.uix.boxlayout.MDBoxLayout
#:import MDCard kivymd.uix.card.MDCard
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDTextField kivymd.uix.textfield.MDTextField
#:import MDIconButton kivymd.uix.button.MDIconButton
#:import MDSwitch kivymd.uix.selectioncontrol.MDSwitch
#:import MDCheckbox kivymd.uix.selectioncontrol.MDCheckbox
#:import OneLineListItem kivymd.uix.list.OneLineListItem
#:import TwoLineListItem kivymd.uix.list.TwoLineListItem
#:import ThreeLineListItem kivymd.uix.list.ThreeLineListItem
#:import MDList kivymd.uix.list.MDList
#:import MDScreen kivymd.uix.screen.MDScreen
#:import MDRectangleFlatButton kivymd.uix.button.MDRectangleFlatButton
#:import Factory kivy.factory.Factory
#:import MDDropdownMenu kivymd.uix.menu.MDDropdownMenu
#:import dp kivy.metrics.dp

<ImageDialog@MDBoxLayout>:
    orientation: 'vertical'
    spacing: dp(15)
    padding: dp(20)
    size_hint_y: None
    height: dp(150)

    MDLabel:
        text: "Choisir une image"
        halign: "center"
        font_style: "H6"

    MDBoxLayout:
        orientation: 'horizontal'
        spacing: dp(10)
        size_hint_y: None
        height: dp(50)

        MDRectangleFlatButton:
            text: "Prendre une photo"
            on_release: app.open_camera()
            size_hint_x: 0.5

        MDRectangleFlatButton:
            text: "Choisir depuis galerie"
            on_release: app.open_gallery()
            size_hint_x: 0.5

<MainScreen>:
    selected_image_path: "assets/logo.png"

    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(10)

        # Barre de recherche
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(10)

            MDTextField:
                id: search_input
                hint_text: "Rechercher..."
                icon_left: "magnify"
                on_text: app.controller.refresh_view(self.text)
                size_hint_x: 0.7

            MDIconButton:
                id: refresh_btn
                icon: "refresh"
                tooltip_text: "Rafraîchir l'affichage"
                on_release: app.controller.refresh_view()
                theme_text_color: "Primary"

            MDIconButton:
                id: sort_btn
                icon: "sort"
                tooltip_text: "Trier les items"
                on_release: app.show_sort_menu()
                theme_text_color: "Primary"

        # Barre d'outils
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(10)

            MDTextField:
                id: name_input
                hint_text: "Nom de l'item"
                size_hint_x: 0.25
                mode: "fill"

            MDTextField:
                id: desc_input
                hint_text: "Description"
                size_hint_x: 0.25
                mode: "fill"

            MDRectangleFlatButton:
                id: image_btn
                text: "Choisir image"
                size_hint_x: 0.2
                on_release: app.show_image_dialog()

            MDRaisedButton:
                text: "Ajouter"
                size_hint_x: 0.15
                on_release:
                    app.controller.add_item(name_input.text, desc_input.text, root.selected_image_path)
                    name_input.text = ""
                    desc_input.text = ""
                    root.selected_image_path = "assets/logo.png"
                    image_btn.text = "Choisir image"

            MDRaisedButton:
                id: delete_selected_btn
                text: "Supprimer"
                size_hint_x: 0.15
                disabled: True
                md_bg_color: 1, 0.3, 0.3, 1
                on_release: app.controller.delete_selected_items()

        # Barre d'actions
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(10)

            MDRaisedButton:
                text: "Tout sélectionner"
                size_hint_x: 0.2
                on_release: app.controller.select_all_items()

            MDRaisedButton:
                text: "Effacer sélection"
                size_hint_x: 0.2
                on_release: app.controller.clear_selection()

            MDRaisedButton:
                id: cleanup_btn
                text: "Nettoyer DB"
                size_hint_x: 0.2
                tooltip_text: "Nettoyer les images manquantes"
                on_release: app.controller.cleanup_missing_images()

            # Contrôle de vue amélioré
            MDBoxLayout:
                orientation: 'horizontal'
                spacing: dp(5)
                size_hint_x: 0.4
                padding: dp(5)

                MDIconButton:
                    id: grid_view_btn
                    icon: "view-grid"
                    tooltip_text: "Vue grille"
                    theme_text_color: "Primary"
                    on_release:
                        app.controller.set_view_mode("grid")
                        grid_view_btn.theme_text_color = "Primary"
                        list_view_btn.theme_text_color = "Secondary"

                MDIconButton:
                    id: list_view_btn
                    icon: "view-list"
                    tooltip_text: "Vue liste"
                    theme_text_color: "Secondary"
                    on_release:
                        app.controller.set_view_mode("list")
                        list_view_btn.theme_text_color = "Primary"
                        grid_view_btn.theme_text_color = "Secondary"

                MDLabel:
                    text: "Vue"
                    halign: "center"
                    valign: "center"
                    size_hint_x: 0.3
                    font_style: "Caption"

        # En-tête avec compteur et info tri
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(10)
            padding: [0, dp(10), 0, dp(5)]

            MDLabel:
                id: items_title
                text: "Mes Items"
                halign: "left"
                font_style: "H5"
                adaptive_height: True
                theme_text_color: "Primary"
                size_hint_x: 0.5

            MDLabel:
                id: sort_info
                text: ""
                halign: "center"
                font_style: "Caption"
                adaptive_height: True
                theme_text_color: "Secondary"
                size_hint_x: 0.3

            MDLabel:
                id: items_count
                text: "(0 items)"
                halign: "right"
                font_style: "Subtitle2"
                adaptive_height: True
                theme_text_color: "Secondary"
                size_hint_x: 0.2

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: main_container
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                # Conteneur pour la vue grille
                GridLayout:
                    id: grid_container
                    cols: 2
                    spacing: dp(15)
                    padding: dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                # Conteneur pour la vue liste
                MDList:
                    id: list_container
                    size_hint_y: None
                    height: self.minimum_height

<ItemCard@MDCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(240)
    padding: dp(10)
    spacing: dp(10)
    elevation: 2
    md_bg_color: app.controller.get_card_color(root.item_id) if app.controller else [1, 1, 1, 1]

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(5)

        MDCheckbox:
            id: item_checkbox
            size_hint: None, None
            size: dp(24), dp(24)
            on_active: app.controller.toggle_item_selection(root.item_id) if app.controller else None

        MDIconButton:
            icon: "pencil"
            size_hint: None, None
            size: dp(24), dp(24)
            theme_text_color: "Secondary"
            on_release: app.controller.edit_item(root.item_id) if app.controller else None

    AsyncImage:
        source: root.source if hasattr(root, 'source') else "assets/logo.png"
        size_hint_y: 0.6
        allow_stretch: True
        keep_ratio: True

    MDLabel:
        text: root.name if hasattr(root, 'name') else ""
        halign: "center"
        font_style: "Subtitle1"
        bold: True
        size_hint_y: 0.2
        text_size: self.width, None

    MDLabel:
        text: root.desc if hasattr(root, 'desc') else ""
        halign: "center"
        font_style: "Body2"
        theme_text_color: "Secondary"
        size_hint_y: 0.2
        text_size: self.width, None

<ListItem@MDBoxLayout>:
    orientation: 'horizontal'
    adaptive_height: True
    spacing: dp(10)
    padding: dp(10)
    size_hint_y: None
    height: dp(80)
    item_id: ""

    MDCheckbox:
        id: list_checkbox
        size_hint: None, None
        size: dp(24), dp(24)
        pos_hint: {'center_y': 0.5}
        on_active: app.controller.toggle_item_selection(root.item_id) if app.controller else None

    # Image miniature dans la vue liste
    AsyncImage:
        id: list_image
        source: root.source if hasattr(root, 'source') else "assets/logo.png"
        size_hint: None, None
        size: dp(50), dp(50)
        pos_hint: {'center_y': 0.5}
        allow_stretch: True
        keep_ratio: True
        mipmap: True

    # Contenu textuel
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        adaptive_height: True
        size_hint_x: 0.6
        pos_hint: {'center_y': 0.5}

        MDLabel:
            id: item_name
            text: root.text if hasattr(root, 'text') else ""
            font_style: "Subtitle1"
            theme_text_color: "Primary"
            adaptive_height: True
            shorten: True
            shorten_from: 'right'
            text_size: self.width, None

        MDLabel:
            id: item_desc
            text: root.secondary_text if hasattr(root, 'secondary_text') else ""
            font_style: "Body2"
            theme_text_color: "Secondary"
            adaptive_height: True
            shorten: True
            shorten_from: 'right'
            text_size: self.width, None

    # BOUTON D'ÉDITION
    MDIconButton:
        icon: "pencil"
        size_hint: None, None
        size: dp(40), dp(40)
        theme_text_color: "Secondary"
        pos_hint: {'center_y': 0.5}
        on_release: app.controller.edit_item(root.item_id) if app.controller else None

<EditDialogContent>:
    orientation: 'vertical'
    spacing: dp(15)
    padding: dp(20)
    size_hint_y: None
    height: dp(250)

    MDLabel:
        text: "Modifier l'item"
        halign: "center"
        font_style: "H6"
        size_hint_y: None
        height: dp(40)

    MDTextField:
        id: name_input
        hint_text: "Nom de l'item"
        size_hint_y: None
        height: dp(60)

    MDTextField:
        id: desc_input
        hint_text: "Description"
        size_hint_y: None
        height: dp(60)

    MDRectangleFlatButton:
        id: image_btn_edit
        text: "Changer l'image"
        size_hint_y: None
        height: dp(50)
        on_release: app.show_edit_image_dialog()
